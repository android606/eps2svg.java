    %!PS-Adobe-3.0 EPSF-3.0
    %%BoundingBox: 0 0 100 100

    /m { moveto } def
    /l { lineto } def
    /cl { closepath } def
    /f { fill } def
    /rg { setrgbcolor } def

    % Draw a red square
    1 0 0 rg  % Red color
    10 10 m
    90 10 l
    90 90 l
    10 90 l
    cl
    f

    showpage
    %%EOF