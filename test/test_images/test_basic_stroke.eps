    %!PS-Adobe-3.0 EPSF-3.0
    %%BoundingBox: 0 0 100 100

    /m { moveto } def
    /l { lineto } def
    /w { setlinewidth } def
    /st { stroke } def
    /rg { setrgbcolor } def

    % Draw a thick blue line
    0 0 1 rg  % Blue color
    5 w       % Line width 5
    10 10 m
    90 90 l
    st

    showpage
    %%EOF