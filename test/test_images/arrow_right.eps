%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 100 100
%%Creator: Claude AI
%%Title: Arrow pointing right
%%EndComments

% Set line width and color
2 setlinewidth
1 0 0 setrgbcolor

% Draw the entire arrow as a single path
newpath
% Start with the shaft
20 48 moveto  % Bottom of shaft
20 52 lineto  % Top of shaft
70 52 lineto  % Top right of shaft
70 60 lineto  % Top of arrowhead
80 50 lineto  % Tip of arrowhead
70 40 lineto  % Bottom of arrowhead
70 48 lineto  % Bottom right of shaft
closepath
1 0 0 setrgbcolor
fill

% End of EPS
%%EOF
