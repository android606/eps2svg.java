%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 100 100
%%Creator: Claude AI
%%Title: Arrow pointing up
%%EndComments

% Set line width and color
2 setlinewidth
0 0 1 setrgbcolor

% Draw the entire arrow as a single path
newpath
% Start with the shaft
48 20 moveto  % Left of shaft
52 20 lineto  % Right of shaft
52 70 lineto  % Right top of shaft
60 70 lineto  % Right of arrowhead
50 80 lineto  % Tip of arrowhead
40 70 lineto  % Left of arrowhead
48 70 lineto  % Left top of shaft
closepath
0 0 1 setrgbcolor
fill

% End of EPS
%%EOF
