%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 100 100
%%Pages: 1
%%EndComments

% Define commands
/c { curveto } bind def
/f { fill } bind def
/m { moveto } bind def
/l { lineto } bind def
/h { closepath } bind def
/s { stroke } bind def

% First shape - using the abbreviation
newpath
10 10 m
20 80 40 90 90 90 c  % Cubic bezier curve
90 50 l
50 30 30 10 10 10 c  % Cubic bezier curve back to start
f

% Second shape - using the full curveto operator
newpath
10 60 moveto
20 70 40 80 60 80 curveto
80 80 90 70 90 60 curveto
90 30 l
60 20 moveto
10 60 lineto
closepath
stroke

% Third shape - a simple test shape
newpath
40 40 moveto
60 40 lineto
60 60 lineto
40 60 lineto
closepath
stroke

showpage
%%EOF 