%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 200 200
%%Creator: Claude AI
%%Title: Complex star shape
%%EndComments

% Set line width and colors
2 setlinewidth
0.8 0.3 0.1 setrgbcolor

% Draw 5-point star
gsave
100 100 translate
0 0 moveto

% Define points of a 5-point star
0 50 moveto
29 15 lineto
47 -40 lineto
0 -15 lineto
-47 -40 lineto
-29 15 lineto
0 50 lineto

% Fill the star with orange
fill

% Stroke the outline in black
0 setgray
2 setlinewidth
0 50 moveto
29 15 lineto
47 -40 lineto
0 -15 lineto
-47 -40 lineto
-29 15 lineto
0 50 lineto
stroke
grestore

% End of EPS
%%EOF 