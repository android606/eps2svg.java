    %!PS-Adobe-3.0 EPSF-3.0
    %%BoundingBox: 0 0 100 100

    /m { moveto } def
    /l { lineto } def
    /cl { closepath } def
    /f { fill } def
    /rg { setrgbcolor } def
    /gs { gsave } def
    /gr { grestore } def
    /np { newpath } def
    /eoclip { W* } def % Assuming W* is eoclip

    % Define a path with two overlapping squares (creates a hole with eofill/eoclip)
    gs
      np
      % Outer square
      10 10 m
      90 10 l
      90 90 l
      10 90 l
      cl
      % Inner square (same direction ok for clip)
      30 30 m
      70 30 l
      70 70 l
      30 70 l
      cl
      eoclip % Use even-odd clipping rule

      % Fill a large red rectangle - should only fill between the squares
      1 0 0 rg % Red
      0 0 m
      100 0 l
      100 100 l
      0 100 l
      cl
      f
    gr % Restore state (removes clipping)

    showpage
    %%EOF